# Kafka
KAFKA_BOOTSTRAP=192.168.88.10:30092
KAFKA_TOPIC_RAW=zendesk.ticket.raw

# Webhook server
PORT=8080
LOG_LEVEL=info

# Zendesk adapter
ZENDESK_WEBHOOK_SECRET=   # HMAC secret from Zendesk webhook config
ZENDESK_ORG_ID=           # iknow org identifier for this Zendesk connection
ZENDESK_INTEGRATION_ID=   # unique ID for this integration instance
